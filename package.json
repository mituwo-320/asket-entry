{
  "name": "tournament-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/guard-production-build.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-release-env.mjs",
    "lint:release": "eslint src/lib/auth src/lib/registration.ts src/lib/participant-fetch.ts src/lib/staff-fetch.ts src/lib/tokens.ts src/lib/mail.ts src/lib/mail.test.ts src/proxy.ts next.config.ts scripts/check-release-env.mjs scripts/guard-production-build.mjs src/app/api/team/register/route.ts src/app/api/team/update/route.ts src/app/api/team/receipt",
    "check": "npm run typecheck && npm test -- --runInBand && npm run lint:release"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.25.0",
    "google-spreadsheet": "^5.0.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  }
}
