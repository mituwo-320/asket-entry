generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  phone          String
  password       String
  postalCode     String?
  address        String?
  wristbandColor String?
  role           String   @default("user")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teamEntries TeamEntry[]
}

model Project {
  id               String    @id @default(cuid()) // ex: "2024-Spring-Day1"
  name             String // "1日目", "4月10日大会", etc.
  isActive         Boolean   @default(true) // Open for general registration
  isWaitlistEnabled Boolean  @default(true) // NEW: Enable/Disable waitlist registration
  isTestProject    Boolean   @default(false) // NEW: テスト用プロジェクトかどうか
  entryStartDate   DateTime?
  entryEndDate     DateTime?
  eventDate        DateTime? // NEW: 大会本番日程
  lineOpenChatLink String?
  maxTeams         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TeamEntry {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id])
  tournamentId               String   @default("2024-Spring")
  teamName                   String
  teamNameKana               String   @default("")
  teamIntroduction           String   @default("")
  isBeginnerFriendlyAccepted Boolean  @default(false)
  isPaid                     Boolean  @default(false)
  status                     String   @default("draft")
  group                      String?
  preliminaryNumber          Int? // NEW: Lottery selection 1-16
  isOpenChatJoined           Boolean  @default(false)
  managementMemo             String   @default("")
  uniformColor               String?
  receiptName                String?  // 領収書の宛名（御社名）ユーザーが設定可能
  receiptIssuedAt            DateTime? // 領収書発行日時（一度発行したら変更不可）
  receiptViewedAt            DateTime? // 領収書閲覧日時（ユーザーが領収書を開いた日時、以降は表示不可）
  createdAt                  DateTime @default(now())

  updatedAt                  DateTime @updatedAt

  players Player[]
}

model Player {
  id               String    @id @default(cuid())
  entryId          String
  teamEntry        TeamEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name             String
  furigana         String    @default("")
  insurance        Boolean   @default(false)
  isRepresentative Boolean   @default(false)
  wristbandColor   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Match {
  id            String   @id @default(cuid())
  tournamentId  String   @default("2024-Spring")
  matchNumber   String?
  type          String   @default("match")
  time          String?
  court         String?
  round         Int?
  teamIdA       String?
  teamIdB       String?
  scoreA        Int?
  scoreB        Int?
  winnerId      String?
  refereeTeamId String?
  status        String   @default("scheduled")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id           String   @id @default(cuid())
  tournamentId String   @default("2024-Spring")
  type         String   @default("event")
  title        String
  startTime    String
  endTime      String?
  court        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id               String    @id @default("default")
  participationFee Int       @default(2500)
  insuranceFee     Int       @default(150)
  lineOpenChatLink String?
  entryDeadline    DateTime?
  updatedAt        DateTime  @updatedAt
}

model TournamentBracket {
  id           String   @id @default(cuid())
  tournamentId String
  teamCount    Int
  brackets     Json     // Full bracket structure stored as JSON
  status       String   @default("setup") // setup | in_progress | completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
